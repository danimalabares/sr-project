(version 1)
(deny default)
(deny network*)
(allow process*)
(allow sysctl-read)
(allow system-fcntl)
(allow mach-lookup)
(allow ipc-posix-shm*)
(allow file-read-metadata file-test-existence
  (literal "/")
  (literal "/Applications")
  (literal "/usr")
  (literal "/usr/local")
  (literal "/usr/local/Cellar")
  (literal "/usr/local/opt")
  (literal "/private")
  (literal "/private/tmp")
  (literal "/private/var"))
(allow file-read*
  (subpath "/System")
  (subpath "/Library/Apple/System")
  (subpath "/Library/Preferences/Logging")
  (subpath "/usr/lib")
  (subpath "/usr/share")
  (subpath "/usr/bin")
  (subpath "/bin")
  (subpath "/private/etc")
  (subpath "/private/var/db")
  (subpath "/private/var/select")
  (subpath "/dev")
  (subpath "/Applications/Macaulay2-1.20")
  (subpath "/usr/local/Cellar")
  (subpath "/usr/local/opt")
  (subpath (param "FRESH")))
(allow file-write*
  (subpath (param "FRESH"))
  (literal "/dev/null"))
(deny file-read* (subpath (param "ORIGINAL")))
(deny file-read* (subpath (param "SOURCE")))
(deny file-read* (subpath (param "PROJECT")))
